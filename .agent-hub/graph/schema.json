{
  "version": 1,
  "name": "design",
  "purpose": "一个代码项目的设计图：旅程、组件、决策、问题与证据",
  "types": {
    "journey": {
      "fields": [
        "goal",
        "stage",
        "notes"
      ],
      "enums": {
        "stage": [
          "specified",
          "implemented",
          "validated"
        ]
      }
    },
    "component": {
      "fields": [
        "responsibility",
        "implementation",
        "maturity"
      ],
      "enums": {
        "maturity": [
          "planned",
          "partial",
          "built"
        ]
      }
    },
    "decision": {
      "fields": [
        "choice",
        "rationale",
        "alternatives",
        "tradeoffs",
        "status"
      ],
      "enums": {
        "status": [
          "proposed",
          "decided",
          "superseded"
        ]
      }
    },
    "problem": {
      "fields": [
        "status",
        "severity",
        "confidence",
        "impact_note"
      ],
      "enums": {
        "status": [
          "open",
          "investigating",
          "mitigated",
          "validated",
          "closed"
        ],
        "severity": [
          "low",
          "medium",
          "high",
          "critical"
        ],
        "confidence": [
          "low",
          "medium",
          "high"
        ]
      }
    },
    "evidence": {
      "fields": [
        "kind",
        "method",
        "ref",
        "result",
        "captured_at"
      ],
      "enums": {
        "kind": [
          "probe",
          "e2e",
          "benchmark",
          "log",
          "doc"
        ],
        "result": [
          "passed",
          "failed",
          "inconclusive"
        ]
      }
    }
  },
  "type_order": [
    "journey",
    "component",
    "problem",
    "decision",
    "evidence"
  ],
  "ui": {
    "journey": {
      "color": "#2f7d6d",
      "fill": "#d9efe8",
      "shape": "pill"
    },
    "component": {
      "color": "#3d5aa8",
      "fill": "#dde5f7",
      "shape": "rect"
    },
    "problem": {
      "color": "#c2542c",
      "fill": "#fbe3d6",
      "shape": "blob"
    },
    "decision": {
      "color": "#7a4bb8",
      "fill": "#ebe0f8",
      "shape": "notch"
    },
    "evidence": {
      "color": "#4c8a3f",
      "fill": "#e3f1da",
      "shape": "doc"
    }
  },
  "relations": [
    "depends_on",
    "owns",
    "routes_via",
    "contributes_to",
    "mitigates",
    "addresses",
    "validated_by",
    "supersedes",
    "conflicts_with",
    "part_of"
  ],
  "transitions": {
    "problem": {
      "field": "status",
      "flow": {
        "open": [
          "investigating",
          "mitigated"
        ],
        "investigating": [
          "open",
          "mitigated"
        ],
        "mitigated": [
          "investigating",
          "validated"
        ],
        "validated": [
          "closed",
          "mitigated"
        ],
        "closed": [
          "open"
        ]
      },
      "require_evidence": {
        "state": "validated",
        "type": "evidence",
        "field": "result",
        "value": "passed",
        "rel": "validated_by"
      }
    }
  },
  "anchor_kinds": [
    "file",
    "url",
    "commit",
    "doc",
    "none"
  ],
  "limits": {
    "excerpt_soft_max": 800,
    "stale_days": 30
  }
}
